{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Platform": {
    "ServiceName": "API Governance Platform Backend",
    "Architecture": "ModularMonolith",
    "ApiBasePath": "/api/v1",
    "ApiVersion": "1.0",
    "BaselineVersion": "1.2",
    "Sprint": "S14",
    "Task": "Q07",
    "EnableOpenApi": false
  },
  "FileStorage": {
    "RootPath": "",
    "MaxUploadBytesCeiling": 104857600
  },
  "FileScanning": {
    "Provider": "ClamAv",
    "ClamAvHost": "",
    "ClamAvPort": 3310,
    "CommandPath": "",
    "CommandArguments": "-Scan -ScanType 3 -File \"{filePath}\" -DisableRemediation",
    "TimeoutSeconds": 30
  },
  "BootstrapAdmin": {
    "Email": "",
    "FullName": "",
    "Password": "",
    "AutoRunOnEmptyDatabase": false
  },
  "AuthenticationPolicy": {
    "Provider": "LocalIdentity",
    "PasswordMinLength": 15,
    "PasswordRequireDigit": true,
    "PasswordRequireLowercase": true,
    "PasswordRequireUppercase": true,
    "PasswordRequireNonAlphanumeric": true,
    "PasswordRequiredUniqueChars": 4,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "LoginRateLimitPermitLimit": 12,
    "LoginRateLimitWindowSeconds": 60,
    "SessionIdleTimeoutMinutes": 30,
    "SessionAbsoluteTimeoutMinutes": 480,
    "ResetTokenLifespanMinutes": 30
  }
}
